# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_RECORD_SECONDS=5

# STT Configuration
# 模型选择：tiny, base, small, medium, large-v3
# M4 芯片推荐使用 medium 模型
STT_MODEL_SIZE=medium
STT_LANGUAGE=zh
STT_DEVICE=auto

# 阿里云 STT 配置（可选）
# ALIYUN_SERVICE=aliyun  # 或 local 使用本地模型
# ALIYUN_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# ALIYUN_APP_KEY=your_app_key
# ALIYUN_REGION=cn-shanghai

# TTS Configuration (using edge-tts: https://github.com/rany2/edge-tts)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=1.0

# Wake System Configuration (Phase 4+)
# Get free access key from https://console.picovoice.ai/
# WAKE_ACCESS_KEY=your_access_key_here
WAKE_KEYWORD=hey computer
WAKE_HOTKEY=<cmd>+<shift>+<space>
